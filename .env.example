# Backend settings (env vars; all optional except the AUTH_* trio in production).
DATA_DIR=./data
TIMEZONE=Europe/London
DECISION_CUTOFF_LOCAL=09:00:00
BAND_CONFIDENCE=0.8
MIN_HISTORY_DAYS=3
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# Login. REQUIRED: the app refuses to start without them (fail closed).
AUTH_USERNAME=
AUTH_PASSWORD=
# >= 32 random chars; signs session cookies.  Generate: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=12
# AUTH_ENABLED=false   # local experiments only, never in production
