  "info": {
    "description": "Day-ahead wind forecast decision support for GB (Elexon FUELHH / WINDFOR).",
    "title": "WindWatch API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/accuracy/by-horizon": {
      "get": {
        "description": "Error of every published revision, bucketed by how far ahead it was made.",
        "operationId": "accuracy_by_horizon_api_v1_accuracy_by_horizon_get",
        "parameters": [
          {
            "description": "First delivery date (inclusive)",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First delivery date (inclusive)",
              "title": "From"
            }
          },
          {
            "description": "Last delivery date (inclusive)",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last delivery date (inclusive)",
              "title": "To"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccuracyGroups"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Accuracy By Horizon",
        "tags": [
          "accuracy"
        ]
      }
    },
